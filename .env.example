# ChainVigil AI local development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
API_HOST=0.0.0.0
API_PORT=4000
BOT_HOST=0.0.0.0
BOT_PORT=4001
CHAINVIGIL_RUNTIME_MODE=mock
WORKER_HEARTBEAT_MS=30000

# Security / networking
# Comma-separated browser origins allowed by API CORS. Defaults include local web/admin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Set to 1 when API/bot sit behind a reverse proxy so rate limits use real client IP.
TRUST_PROXY=0
# Server-to-server write secret for points/referral events (not NEXT_PUBLIC_*).
# Required in production. In mock mode, omit to allow unauthenticated local writes.
INTERNAL_WRITE_SECRET=
# Telegram webhook secret (X-Telegram-Bot-Api-Secret-Token). Required in production.
TELEGRAM_WEBHOOK_SECRET=

# Database and cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chainvigil_ai
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=postgres

# External risk data providers, optional in V0 mock mode
GOPLUS_API_KEY=
HONEYPOT_API_KEY=
RPC_ETHEREUM_URL=
RPC_BSC_URL=
RPC_SOLANA_URL=
RPC_BASE_URL=
RPC_ARBITRUM_URL=
RPC_POLYGON_URL=
RPC_OPTIMISM_URL=

# Bot and admin
TELEGRAM_BOT_TOKEN=
ADMIN_BASIC_AUTH_USERNAME=admin
# Leave empty for local open Admin UI/API. Required in production (>=16 chars, not a placeholder).
ADMIN_BASIC_AUTH_PASSWORD=
ADMIN_SECRET=replace-me
JWT_SECRET=replace-me
