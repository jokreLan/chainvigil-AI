# ChainVigil AI · production template (fill on weekend)
# Copy to secure secret store / host env — never commit real values.

CHAINVIGIL_RUNTIME_MODE=production
CHAINVIGIL_LIVE_PROVIDERS=true

# Public HTTPS origins (no localhost)
APP_BASE_URL=https://chainvigil.ai
API_BASE_URL=https://api.chainvigil.ai
NEXT_PUBLIC_APP_BASE_URL=https://chainvigil.ai
NEXT_PUBLIC_API_BASE_URL=https://api.chainvigil.ai
ADMIN_BASE_URL=https://admin.chainvigil.ai

API_HOST=0.0.0.0
API_PORT=4000
BOT_HOST=0.0.0.0
BOT_PORT=4001

# Behind reverse proxy
TRUST_PROXY=1
CORS_ALLOWED_ORIGINS=https://chainvigil.ai,https://admin.chainvigil.ai

# Secrets (>=16 chars, not placeholders)
ADMIN_BASIC_AUTH_USERNAME=admin
ADMIN_BASIC_AUTH_PASSWORD=
ADMIN_SECRET=
JWT_SECRET=
INTERNAL_WRITE_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Data plane (weekend)
DATABASE_URL=
REDIS_URL=
GOPLUS_API_KEY=
HONEYPOT_API_KEY=
RPC_SOLANA_URL=
RPC_BSC_URL=

# Optional observability
CHAINVIGIL_COMMIT_SHA=
LOG_LEVEL=info
SUPPORT_EMAIL=
SECURITY_CONTACT=
WORKER_HEARTBEAT_MS=30000
