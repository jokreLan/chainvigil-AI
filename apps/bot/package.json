{
  "name": "@chainvigil/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@chainvigil/chain": "workspace:*",
    "@chainvigil/config": "workspace:*",
    "@chainvigil/report": "workspace:*",
    "@chainvigil/risk-core": "workspace:*",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
